---
import Base from '../../layouts/Base.astro';
import { isAdmin } from '../../lib/auth';
import { db } from '../../lib/db';
if(!isAdmin(Astro.cookies)) return Astro.redirect('/admin/login');
const allowedStatuses=['all','draft','pending','published','hidden'] as const;
const statusParam=Astro.url.searchParams.get('status')||'all';
const status=allowedStatuses.find(s=>s===statusParam)||'all';
const pageParam=Number(Astro.url.searchParams.get('page')||'1');
const page=Number.isSafeInteger(pageParam)&&pageParam>0?Math.min(pageParam,100000):1;
const perPage=50;
const offset=(page-1)*perPage;
const totals=await db()`SELECT status,count(*)::int AS count FROM events GROUP BY status`;
const total=totals.reduce((sum,r)=>sum+Number(r.count),0);
const filteredTotal=status==='all'?total:Number(totals.find(r=>r.status===status)?.count||0);
const events=await db()`SELECT e.id,e.title,e.starts_at,e.status,v.name AS venue_name FROM events e JOIN venues v ON v.id=e.venue_id WHERE (${status}='all' OR e.status=${status}) ORDER BY e.created_at DESC,e.id DESC LIMIT ${perPage} OFFSET ${offset}`;
const pageLink=(p:number,s=status)=>'/admin?status='+s+'&page='+p;
const venues=await db()`SELECT id,name FROM venues ORDER BY name`;
const requests=await db()`SELECT r.id,r.field,r.note,r.created_at,e.title FROM edit_requests r JOIN events e ON e.id=r.event_id WHERE NOT r.resolved ORDER BY r.created_at DESC LIMIT 30`;
const message=Astro.url.searchParams.get('message');
const statusNames:Record<string,string>={draft:'초안',pending:'검수 대기',published:'게시됨',hidden:'비공개'};
const pending=Number(totals.find(r=>r.status==='pending')?.count||0);
const published=Number(totals.find(r=>r.status==='published')?.count||0);
---
<Base title="운영자 대시보드" noindex><h1>공연 운영</h1>
  <nav class="admin-nav"><a class="btn" href="/admin/events/new">공연 등록</a><a class="btn" href="/admin/import">JSON 가져오기</a><a class="btn" href="#venue">공연장 추가</a><form action="/api/admin/logout" method="POST"><button class="btn" type="submit">로그아웃</button></form></nav>
  {message&&<p class="notice">{message==='saved'?'저장했습니다.':message==='venue'?'공연장을 추가했습니다.':message==='resolved'?'수정 요청을 처리했습니다.':'작업을 처리하지 못했습니다.'}</p>}
  <p class="notice">전체 공연 {total}건 · 검수 대기 <strong>{pending}건</strong> · 게시 중 {published}건</p>
  <h2>공연 ({filteredTotal}건 · {page}페이지)</h2>
  <nav class="admin-nav" aria-label="공연 상태 필터">
    {allowedStatuses.map(s=><a href={pageLink(1,s)} aria-current={status===s?'page':undefined}>{s==='all'?'전체':statusNames[s]} ({s==='all'?total:Number(totals.find(r=>r.status===s)?.count||0)})</a>)}
  </nav>
  <div class="table-scroll"><table class="admin-table"><thead><tr><th>공연</th><th>공연장</th><th>날짜</th><th>상태</th><th>수정</th></tr></thead><tbody>{events.map(e=><tr><td>{e.title}</td><td>{e.venue_name}</td><td>{new Date(e.starts_at).toLocaleString('ko-KR',{timeZone:'Asia/Seoul'})}</td><td><span class="pill">{statusNames[String(e.status)]||e.status}</span></td><td><a href={`/admin/events/${e.id}`}>편집</a></td></tr>)}</tbody></table></div>
  {events.length===0&&<p class="muted">해당 조건의 공연이 없습니다.</p>}
  <nav class="admin-nav" aria-label="공연 페이지">
    {page>1&&<a class="btn" href={pageLink(page-1)}>이전</a>}
    <span>{page} / {Math.max(1,Math.ceil(filteredTotal/perPage))} 페이지</span>
    {page*perPage<filteredTotal&&<a class="btn" href={pageLink(page+1)}>다음</a>}
  </nav>
  <section id="venue" class="detail-section" style="margin-top:35px"><h2>공연장 등록</h2><p class="small muted">기존 공연장 {venues.length}곳 · 중복 생성에 유의하세요.</p>
  {venues.length>0&&<div class="notice"><strong>등록된 공연장 ID</strong><p class="small">{venues.map(v=>`${v.name} (#${v.id})`).join(" · ")}</p></div>}<form method="POST" action="/api/admin/venues">
    <div class="field"><label for="vname">공연장 이름</label><input id="vname" name="name" required maxlength="120"/></div>
    <div class="field"><label for="address">도로명 주소</label><input id="address" name="address" required maxlength="300"/></div>
    <div class="fact-grid"><div class="field"><label for="lat">위도 (선택)</label><input id="lat" name="lat" type="number" step="any"/></div><div class="field"><label for="lng">경도 (선택)</label><input id="lng" name="lng" type="number" step="any"/></div></div>
    <div class="field"><label for="instagram">Instagram 아이디 (선택)</label><input id="instagram" name="instagram" maxlength="100"/></div>
    <button class="btn" type="submit">공연장 추가</button></form>
  </section>
  <section class="detail-section"><h2>접수된 정보 수정 요청 ({requests.length}건)</h2>
    {requests.map(r=><div class="notice"><strong>{r.title} · {r.field}</strong><p>{r.note||'설명 없음'}</p><form action="/api/admin/resolve" method="POST"><input type="hidden" name="id" value={r.id}/><button class="btn" type="submit">처리 완료</button></form></div>)}
    {requests.length===0&&<p>대기 중인 수정 요청이 없습니다.</p>}
  </section>
</Base>

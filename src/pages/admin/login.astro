---
import Base from '../../layouts/Base.astro';
import { isAdmin } from '../../lib/auth';
if(isAdmin(Astro.cookies)) return Astro.redirect('/admin');
const error=Astro.url.searchParams.get('error');
---
<Base title="관리자 로그인" noindex><section style="max-width:430px;margin:40px auto"><h1>관리자 로그인</h1><p class="muted">공연 정보는 운영자 승인 후 공개됩니다.</p>{error&&<p class="notice error">비밀번호가 올바르지 않습니다.</p>}<form action="/api/admin/login" method="POST"><div class="field"><label for="password">관리자 비밀번호</label><input id="password" type="password" name="password" minlength="16" required autocomplete="current-password"/></div><button class="btn primary" type="submit">로그인</button></form></section></Base>

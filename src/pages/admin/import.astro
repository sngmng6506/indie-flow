---
import Base from '../../layouts/Base.astro';
import {isAdmin} from '../../lib/auth';
if(!isAdmin(Astro.cookies))return Astro.redirect('/admin/login');
const example=JSON.stringify([{venueId:1,title:'공연명',startsAt:'2026-12-01T20:00',sourceUrl:'https://example.com/official-event',lineup:'출연 밴드',doorPrice:25000}],null,2);
---
<Base title="공연 JSON 가져오기" noindex>
  <p><a href="/admin">← 관리자로</a></p><h1>공연 JSON 가져오기</h1>
  <p>이미 수집한 공연 목록을 입력할 수 있습니다. 모든 항목은 <strong>검수 대기(pending)</strong>로 저장되며 승인 전 공개되지 않습니다.</p>
  <p class="muted small">먼저 관리자 화면에서 공연장을 등록하고 ID를 확인하세요. 각 공연에는 공연장 ID, 공연명, 한국시간 시작일, 공식 출처 HTTPS URL이 필요합니다. 최대 100건/1MB.</p>
  <form id="import-form">
    <div class="field"><label for="payload">공연 JSON 배열</label><textarea id="payload" rows="15" style="min-height:300px;font-family:monospace" required>{example}</textarea></div>
    <button class="btn primary" type="submit">검수 대기열에 가져오기</button>
  </form>
  <p id="import-result" class="notice" aria-live="polite" hidden></p>
</Base>
<script>
const form=document.querySelector<HTMLFormElement>('#import-form');
form?.addEventListener('submit',async e=>{
  e.preventDefault();const raw=(document.querySelector<HTMLTextAreaElement>('#payload')?.value||'');
  const result=document.querySelector<HTMLElement>('#import-result')!;
  result.hidden=false;
  try {
    const parsed=JSON.parse(raw);
    const response=await fetch('/api/admin/import',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(parsed)});
    const data=await response.json();
    if(!response.ok)throw Error(data.error?.message||'데이터를 저장하지 못했습니다.');
    result.textContent=`등록 ${data.inserted}건 · 중복 제외 ${data.skipped}건. 관리자 화면에서 검수 후 게시하세요.`;
  } catch(err) {result.textContent=err instanceof Error?err.message:'JSON 형식이 올바르지 않습니다.';}
});
</script>

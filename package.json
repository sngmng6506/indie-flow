{
  "name": "indie-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "start": "node scripts/bootstrap.mjs",
    "check": "astro check",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "collect:events": "tsx scripts/collect-events.ts",
    "collect:export": "tsx scripts/collect-events.ts --import-json",
    "db:seed:verified": "node scripts/seed-verified-2026.mjs",
    "db:seed:extended": "node scripts/seed-extended-2026.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^9.4.0",
    "@astrojs/react": "^4.3.0",
    "@astrojs/sitemap": "^3.4.0",
    "astro": "^5.16.0",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
